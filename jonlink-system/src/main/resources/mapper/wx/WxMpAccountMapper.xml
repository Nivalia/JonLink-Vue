<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.WxMpAccountMapper">
    
    <resultMap type="WxMpAccount" id="WxMpAccountResult">
        <result property="id"    column="id"    />
        <result property="appId"    column="app_id"    />
        <result property="appSecret"    column="app_secret"    />
        <result property="name"    column="name"    />
        <result property="token"    column="token"    />
        <result property="encodingAesKey"    column="encoding_aes_key"    />
        <result property="encryptMode"    column="encrypt_mode"    />
        <result property="accessToken"    column="access_token"    />
        <result property="tokenExpireTime"    column="token_expire_time"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWxMpAccountVo">
        select id, app_id, app_secret, name, token, encoding_aes_key, encrypt_mode, access_token, token_expire_time, status, remark, create_by, create_time, update_by, update_time from wx_mp_account
    </sql>

    <select id="selectWxMpAccountList" parameterType="WxMpAccount" resultMap="WxMpAccountResult">
        <include refid="selectWxMpAccountVo"/>
        <where>  
        </where>
    </select>
    
    <select id="selectWxMpAccountById" parameterType="Long" resultMap="WxMpAccountResult">
        <include refid="selectWxMpAccountVo"/>
        where id = #{id}
    </select>

    <insert id="insertWxMpAccount" parameterType="WxMpAccount" useGeneratedKeys="true" keyProperty="id">
        insert into wx_mp_account
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="appId != null and appId != ''">app_id,</if>
            <if test="appSecret != null and appSecret != ''">app_secret,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="token != null and token != ''">token,</if>
            <if test="encodingAesKey != null and encodingAesKey != ''">encoding_aes_key,</if>
            <if test="encryptMode != null and encryptMode != ''">encrypt_mode,</if>
            <if test="accessToken != null and accessToken != ''">access_token,</if>
            <if test="tokenExpireTime != null">token_expire_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="appId != null and appId != ''">#{appId},</if>
            <if test="appSecret != null and appSecret != ''">#{appSecret},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="token != null and token != ''">#{token},</if>
            <if test="encodingAesKey != null and encodingAesKey != ''">#{encodingAesKey},</if>
            <if test="encryptMode != null and encryptMode != ''">#{encryptMode},</if>
            <if test="accessToken != null and accessToken != ''">#{accessToken},</if>
            <if test="tokenExpireTime != null">#{tokenExpireTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateWxMpAccount" parameterType="WxMpAccount">
        update wx_mp_account
        <trim prefix="SET" suffixOverrides=",">
            <if test="appId != null and appId != ''">app_id = #{appId},</if>
            <if test="appSecret != null and appSecret != ''">app_secret = #{appSecret},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="token != null and token != ''">token = #{token},</if>
            <if test="encodingAesKey != null and encodingAesKey != ''">encoding_aes_key = #{encodingAesKey},</if>
            <if test="encryptMode != null and encryptMode != ''">encrypt_mode = #{encryptMode},</if>
            <if test="accessToken != null and accessToken != ''">access_token = #{accessToken},</if>
            <if test="tokenExpireTime != null">token_expire_time = #{tokenExpireTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWxMpAccountById" parameterType="Long">
        delete from wx_mp_account where id = #{id}
    </delete>

    <delete id="deleteWxMpAccountByIds" parameterType="String">
        delete from wx_mp_account where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>