<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.WxQrSceneMapper">
    
    <resultMap type="WxQrScene" id="WxQrSceneResult">
        <result property="id"    column="id"    />
        <result property="sceneId"    column="scene_id"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="qrType"    column="qr_type"    />
        <result property="ticket"    column="ticket"    />
        <result property="qrUrl"    column="qr_url"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="bizType"    column="biz_type"    />
        <result property="sceneStr"    column="scene_str"    />
        <result property="expireTime"    column="expire_time"    />
        <result property="landingUrl"    column="landing_url"    />
        <result property="scanCount"    column="scan_count"    />
    </resultMap>

    <sql id="selectWxQrSceneVo">
        select s.id, s.scene_id, s.user_id, s.user_name, s.qr_type, s.ticket, s.qr_url, s.status, s.create_by, s.create_time, s.update_by, s.update_time, s.remark, s.biz_type, s.scene_str, s.expire_time, s.landing_url,
               (select count(*) from wx_qr_scan_log l where l.scene_id = s.scene_id) as scan_count
        from wx_qr_scene s
    </sql>

    <select id="selectWxQrSceneList" parameterType="WxQrScene" resultMap="WxQrSceneResult">
        <include refid="selectWxQrSceneVo"/>
        <where>  
            <if test="sceneId != null"> and scene_id = #{sceneId}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="qrType != null and qrType != ''"> and qr_type = #{qrType}</if>
            <if test="bizType != null  and bizType != ''"> and biz_type = #{bizType}</if>
            <if test="expireTime != null "> and expire_time = #{expireTime}</if>
        </where>
    </select>
    
    <select id="selectWxQrSceneById" parameterType="Long" resultMap="WxQrSceneResult">
        <include refid="selectWxQrSceneVo"/>
        where s.id = #{id}
    </select>

    <insert id="insertWxQrScene" parameterType="WxQrScene" useGeneratedKeys="true" keyProperty="id">
        insert into wx_qr_scene
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sceneId != null">scene_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="qrType != null and qrType != ''">qr_type,</if>
            <if test="ticket != null">ticket,</if>
            <if test="qrUrl != null">qr_url,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="bizType != null and bizType != ''">biz_type,</if>
            <if test="sceneStr != null">scene_str,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="landingUrl != null">landing_url,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sceneId != null">#{sceneId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="qrType != null and qrType != ''">#{qrType},</if>
            <if test="ticket != null">#{ticket},</if>
            <if test="qrUrl != null">#{qrUrl},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="bizType != null and bizType != ''">#{bizType},</if>
            <if test="sceneStr != null">#{sceneStr},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="landingUrl != null">#{landingUrl},</if>
         </trim>
    </insert>

    <update id="updateWxQrScene" parameterType="WxQrScene">
        update wx_qr_scene
        <trim prefix="SET" suffixOverrides=",">
            <if test="sceneId != null">scene_id = #{sceneId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="qrType != null and qrType != ''">qr_type = #{qrType},</if>
            <if test="ticket != null">ticket = #{ticket},</if>
            <if test="qrUrl != null">qr_url = #{qrUrl},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="bizType != null and bizType != ''">biz_type = #{bizType},</if>
            <if test="sceneStr != null">scene_str = #{sceneStr},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="landingUrl != null">landing_url = #{landingUrl},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWxQrSceneById" parameterType="Long">
        delete from wx_qr_scene where id = #{id}
    </delete>

    <delete id="deleteWxQrSceneByIds" parameterType="String">
        delete from wx_qr_scene where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>