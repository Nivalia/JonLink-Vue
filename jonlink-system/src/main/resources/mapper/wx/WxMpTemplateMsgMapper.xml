    <sql id="selectWxMpTemplateMsgVo">
        select id, batch_no, transpose_no, openid, phone, template_id, url, keywords, msg_id, status, err_msg, source, biz_type, biz_id, row_no, group_id, send_time, create_by, create_time, update_by, update_time from wx_mp_template_msg
    </sql>

    <select id="selectWxMpTemplateMsgList" parameterType="WxMpTemplateMsg" resultMap="WxMpTemplateMsgResult">
        <include refid="selectWxMpTemplateMsgVo"/>
        <where>  
            <if test="batchNo != null  and batchNo != ''"> and batch_no = #{batchNo}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="createTime != null "> and create_time = #{createTime}</if>
        </where>
    </select>
    
    <select id="selectWxMpTemplateMsgById" parameterType="Long" resultMap="WxMpTemplateMsgResult">
        <include refid="selectWxMpTemplateMsgVo"/>
        where id = #{id}
    </select>

    <insert id="insertWxMpTemplateMsg" parameterType="WxMpTemplateMsg" useGeneratedKeys="true" keyProperty="id">
        insert into wx_mp_template_msg
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="batchNo != null">batch_no,</if>
            <if test="transposeNo != null">transpose_no,</if>
            <if test="openid != null and openid != ''">openid,</if>
            <if test="phone != null">phone,</if>
            <if test="templateId != null and templateId != ''">template_id,</if>
            <if test="url != null">url,</if>
            <if test="keywords != null">keywords,</if>
            <if test="msgId != null">msg_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="errMsg != null">err_msg,</if>
            <if test="source != null and source != ''">source,</if>
            <if test="bizType != null">biz_type,</if>
            <if test="bizId != null">biz_id,</if>
            <if test="rowNo != null">row_no,</if>
            <if test="groupId != null">group_id,</if>
            <if test="sendTime != null">send_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="batchNo != null">#{batchNo},</if>
            <if test="transposeNo != null">#{transposeNo},</if>
            <if test="openid != null and openid != ''">#{openid},</if>
            <if test="phone != null">#{phone},</if>
            <if test="templateId != null and templateId != ''">#{templateId},</if>
            <if test="url != null">#{url},</if>
            <if test="keywords != null">#{keywords},</if>
            <if test="msgId != null">#{msgId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="errMsg != null">#{errMsg},</if>
            <if test="source != null and source != ''">#{source},</if>
            <if test="bizType != null">#{bizType},</if>
            <if test="bizId != null">#{bizId},</if>
            <if test="rowNo != null">#{rowNo},</if>
            <if test="groupId != null">#{groupId},</if>
            <if test="sendTime != null">#{sendTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
