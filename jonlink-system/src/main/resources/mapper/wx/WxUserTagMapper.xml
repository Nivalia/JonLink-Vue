<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.WxUserTagMapper">
    
    <resultMap type="com.jonlink.system.domain.WxUserTag" id="WxUserTagResult">
        <result property="id"        column="id"        />
        <result property="userId"    column="user_id"   />
        <result property="tagId"     column="tag_id"    />
        <result property="tagName"   column="tag_name"  />
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectWxUserTagVo">
        select ut.id, ut.user_id, ut.tag_id, t.tag_name, ut.create_time
        from wx_user_tag ut
        left join wx_tag t on ut.tag_id = t.id
    </sql>

    <select id="selectWxUserTagById" parameterType="Long" resultMap="WxUserTagResult">
        <include refid="selectWxUserTagVo"/>
        where ut.id = #{id}
    </select>

    <select id="selectWxUserTagList" parameterType="com.jonlink.system.domain.WxUserTag" resultMap="WxUserTagResult">
        <include refid="selectWxUserTagVo"/>
        <where>
            <if test="userId != null">
                and ut.user_id = #{userId}
            </if>
            <if test="tagId != null">
                and ut.tag_id = #{tagId}
            </if>
            <if test="tagName != null and tagName != ''">
                and t.tag_name like concat('%', #{tagName}, '%')
            </if>
        </where>
        order by ut.create_time desc
    </select>

    <select id="selectTagsByUserId" parameterType="Long" resultMap="WxUserTagResult">
        <include refid="selectWxUserTagVo"/>
        where ut.user_id = #{userId}
        order by ut.create_time desc
    </select>

    <insert id="insertWxUserTag" parameterType="com.jonlink.system.domain.WxUserTag" useGeneratedKeys="true" keyProperty="id">
        insert into wx_user_tag
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="tagId != null">tag_id,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="tagId != null">#{tagId},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateWxUserTag" parameterType="com.jonlink.system.domain.WxUserTag">
        update wx_user_tag
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="tagId != null">tag_id = #{tagId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWxUserTagById" parameterType="Long">
        delete from wx_user_tag where id = #{id}
    </delete>

    <delete id="deleteWxUserTagByIds" parameterType="String">
        delete from wx_user_tag where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteTagsByUserId" parameterType="Long">
        delete from wx_user_tag where user_id = #{userId}
    </delete>

    <insert id="batchInsertUserTags" parameterType="java.util.List">
        insert into wx_user_tag (user_id, tag_id, create_time) values
        <foreach item="item" collection="list" separator=",">
            (#{item.userId}, #{item.tagId}, #{item.createTime})
        </foreach>
    </insert>

</mapper>
