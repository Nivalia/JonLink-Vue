<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.WxBizOrderMapper">
    
    <resultMap type="WxBizOrder" id="WxBizOrderResult">
        <result property="id"    column="id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="phone"    column="phone"    />
        <result property="customerName"    column="customer_name"    />
        <result property="serviceType"    column="service_type"    />
        <result property="carNo"    column="car_no"    />
        <result property="amount"    column="amount"    />
        <result property="orderType"    column="order_type"    />
        <result property="sourceType"    column="source_type"    />
        <result property="status"    column="status"    />
        <result property="verifyStatus"    column="verify_status"    />
        <result property="verifyTime"    column="verify_time"    />
        <result property="verifyMsg"    column="verify_msg"    />
        <result property="extJson"    column="ext_json"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWxBizOrderVo">
        select id, order_no, phone, customer_name, service_type, car_no, amount, order_type, source_type, status, verify_status, verify_time, verify_msg, ext_json, remark, create_by, create_time, update_by, update_time from wx_biz_order
    </sql>

    <select id="selectWxBizOrderList" parameterType="WxBizOrder" resultMap="WxBizOrderResult">
        <include refid="selectWxBizOrderVo"/>
        <where>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="sourceType != null and sourceType != ''"> and source_type = #{sourceType}</if>
        </where>
    </select>
    
    <select id="selectWxBizOrderById" parameterType="Long" resultMap="WxBizOrderResult">
        <include refid="selectWxBizOrderVo"/>
        where id = #{id}
    </select>

    <insert id="insertWxBizOrder" parameterType="WxBizOrder" useGeneratedKeys="true" keyProperty="id">
        insert into wx_biz_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="customerName != null">customer_name,</if>
            <if test="serviceType != null">service_type,</if>
            <if test="carNo != null">car_no,</if>
            <if test="amount != null">amount,</if>
            <if test="orderType != null">order_type,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="verifyStatus != null and verifyStatus != ''">verify_status,</if>
            <if test="verifyTime != null">verify_time,</if>
            <if test="verifyMsg != null">verify_msg,</if>
            <if test="extJson != null">ext_json,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="customerName != null">#{customerName},</if>
            <if test="serviceType != null">#{serviceType},</if>
            <if test="carNo != null">#{carNo},</if>
            <if test="amount != null">#{amount},</if>
            <if test="orderType != null">#{orderType},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="verifyStatus != null and verifyStatus != ''">#{verifyStatus},</if>
            <if test="verifyTime != null">#{verifyTime},</if>
            <if test="verifyMsg != null">#{verifyMsg},</if>
            <if test="extJson != null">#{extJson},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateWxBizOrder" parameterType="WxBizOrder">
        update wx_biz_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="customerName != null">customer_name = #{customerName},</if>
            <if test="serviceType != null">service_type = #{serviceType},</if>
            <if test="carNo != null">car_no = #{carNo},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="orderType != null">order_type = #{orderType},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="verifyStatus != null and verifyStatus != ''">verify_status = #{verifyStatus},</if>
            <if test="verifyTime != null">verify_time = #{verifyTime},</if>
            <if test="verifyMsg != null">verify_msg = #{verifyMsg},</if>
            <if test="extJson != null">ext_json = #{extJson},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWxBizOrderById" parameterType="Long">
        delete from wx_biz_order where id = #{id}
    </delete>

    <delete id="deleteWxBizOrderByIds" parameterType="String">
        delete from wx_biz_order where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 归档: 拉候选 -->
    <select id="selectArchiveCandidates" resultMap="WxBizOrderResult">
        <include refid="selectWxBizOrderVo"/>
        where verify_status = '1'
          and create_time &lt; date_sub(now(), interval #{days} day)
        order by id asc
        limit 500
    </select>

    <!-- 归档: 查台账 down_settle_status(IFNULL 防无此单返回 NULL) -->
    <select id="selectLedgerDownSettleStatusByOrderNo" resultType="int">
        select ifnull((select down_settle_status from jonlink_insurance_ledger where policy_no = #{orderNo} limit 1), -1)
    </select>

    <!-- 归档: INSERT archive + DELETE 主表(同事务) -->
    <insert id="moveToArchive">
        INSERT INTO wx_biz_order_archive
        (id, order_no, phone, customer_name, service_type, car_no, amount, order_type, source_type, status, verify_status, verify_time, verify_msg, ext_json, remark, create_by, create_time, update_by, update_time)
        SELECT id, order_no, phone, customer_name, service_type, car_no, amount, order_type, source_type, status, verify_status, verify_time, verify_msg, ext_json, remark, create_by, create_time, update_by, update_time
        FROM wx_biz_order WHERE id = #{id}
    </insert>
</mapper>