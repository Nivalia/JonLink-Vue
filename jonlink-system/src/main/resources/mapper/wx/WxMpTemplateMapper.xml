<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.WxMpTemplateMapper">
    
    <resultMap type="WxMpTemplate" id="WxMpTemplateResult">
        <result property="id"    column="id"    />
        <result property="templateId"    column="template_id"    />
        <result property="templateIdShort"    column="template_id_short"    />
        <result property="title"    column="title"    />
        <result property="content"    column="content"    />
        <result property="keywordOrder"    column="keyword_order"    />
        <result property="primaryIndustry"    column="primary_industry"    />
        <result property="deputyIndustry"    column="deputy_industry"    />
        <result property="example"    column="example"    />
        <result property="keywordMeta"    column="keyword_meta"    />
        <result property="urlType"    column="url_type"    />
        <result property="h5PageId"    column="h5_page_id"    />
        <result property="customUrl"    column="custom_url"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectWxMpTemplateVo">
        select id, template_id, template_id_short, title, content, keyword_order, primary_industry, deputy_industry, example, keyword_meta, url_type, h5_page_id, custom_url, status, remark, create_by, create_time, update_by, update_time from wx_mp_template
    </sql>

    <select id="selectWxMpTemplateList" parameterType="WxMpTemplate" resultMap="WxMpTemplateResult">
        <include refid="selectWxMpTemplateVo"/>
        <where>  
            <if test="templateId != null  and templateId != ''"> and template_id = #{templateId}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
        </where>
    </select>
    
    <select id="selectWxMpTemplateById" parameterType="Long" resultMap="WxMpTemplateResult">
        <include refid="selectWxMpTemplateVo"/>
        where id = #{id}
    </select>

    <select id="selectWxMpTemplateByTemplateId" parameterType="String" resultMap="WxMpTemplateResult">
        <include refid="selectWxMpTemplateVo"/>
        where template_id = #{templateId} limit 1
    </select>

    <insert id="insertWxMpTemplate" parameterType="WxMpTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into wx_mp_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateId != null and templateId != ''">template_id,</if>
            <if test="templateIdShort != null and templateIdShort != ''">template_id_short,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="keywordOrder != null and keywordOrder != ''">keyword_order,</if>
            <if test="primaryIndustry != null">primary_industry,</if>
            <if test="deputyIndustry != null">deputy_industry,</if>
            <if test="example != null">example,</if>
            <if test="keywordMeta != null">keyword_meta,</if>
            <if test="urlType != null">url_type,</if>
            <if test="h5PageId != null">h5_page_id,</if>
            <if test="customUrl != null">custom_url,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateId != null and templateId != ''">#{templateId},</if>
            <if test="templateIdShort != null and templateIdShort != ''">#{templateIdShort},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="keywordOrder != null and keywordOrder != ''">#{keywordOrder},</if>
            <if test="primaryIndustry != null">#{primaryIndustry},</if>
            <if test="deputyIndustry != null">#{deputyIndustry},</if>
            <if test="example != null">#{example},</if>
            <if test="keywordMeta != null">#{keywordMeta},</if>
            <if test="urlType != null">#{urlType},</if>
            <if test="h5PageId != null">#{h5PageId},</if>
            <if test="customUrl != null">#{customUrl},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateWxMpTemplate" parameterType="WxMpTemplate">
        update wx_mp_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateId != null and templateId != ''">template_id = #{templateId},</if>
            <if test="templateIdShort != null and templateIdShort != ''">template_id_short = #{templateIdShort},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="keywordOrder != null and keywordOrder != ''">keyword_order = #{keywordOrder},</if>
            <if test="primaryIndustry != null">primary_industry = #{primaryIndustry},</if>
            <if test="deputyIndustry != null">deputy_industry = #{deputyIndustry},</if>
            <if test="example != null">example = #{example},</if>
            <if test="keywordMeta != null">keyword_meta = #{keywordMeta},</if>
            <if test="urlType != null">url_type = #{urlType},</if>
            <if test="h5PageId != null">h5_page_id = #{h5PageId},</if>
            <if test="customUrl != null">custom_url = #{customUrl},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWxMpTemplateById" parameterType="Long">
        delete from wx_mp_template where id = #{id}
    </delete>

    <delete id="deleteWxMpTemplateByIds" parameterType="String">
        delete from wx_mp_template where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>