<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.PolicyCategoryMapper">

    <resultMap type="PolicyCategory" id="PolicyCategoryResult">
        <result property="id"            column="id"/>
        <result property="parentId"      column="parent_id"/>
        <result property="categoryName"  column="category_name"/>
        <result property="sort"          column="sort"/>
        <result property="status"        column="status"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
        <result property="remark"        column="remark"/>
    </resultMap>

    <sql id="selectPolicyCategoryVo">
        select id, parent_id, category_name, sort, status, create_by, create_time, update_by, update_time, remark
        from policy_category
    </sql>

    <select id="selectPolicyCategoryList" parameterType="PolicyCategory" resultMap="PolicyCategoryResult">
        <include refid="selectPolicyCategoryVo"/>
        <where>
            <if test="categoryName != null and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="parentId != null"> and parent_id = #{parentId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by parent_id, sort, id
    </select>

    <!-- 树查询:全拉出后,前端或 service 拼装 children -->
    <select id="selectPolicyCategoryTree" parameterType="PolicyCategory" resultMap="PolicyCategoryResult">
        <include refid="selectPolicyCategoryVo"/>
        <where>
            <if test="categoryName != null and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by parent_id, sort, id
    </select>

    <select id="selectPolicyCategoryById" parameterType="Long" resultMap="PolicyCategoryResult">
        <include refid="selectPolicyCategoryVo"/>
        where id = #{id}
    </select>

    <select id="checkCategoryNameUnique" parameterType="PolicyCategory" resultMap="PolicyCategoryResult">
        <include refid="selectPolicyCategoryVo"/>
        where parent_id = #{parentId} and category_name = #{categoryName}
        limit 1
    </select>

    <insert id="insertPolicyCategory" parameterType="PolicyCategory" useGeneratedKeys="true" keyProperty="id">
        insert into policy_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updatePolicyCategory" parameterType="PolicyCategory">
        update policy_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePolicyCategoryById" parameterType="Long">
        delete from policy_category where id = #{id}
    </delete>

    <delete id="deletePolicyCategoryByIds" parameterType="Long[]">
        delete from policy_category where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
