<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.PolicyArticleMapper">

    <resultMap type="PolicyArticle" id="PolicyArticleResult">
        <result property="id"            column="id"/>
        <result property="categoryId"    column="category_id"/>
        <result property="categoryName"  column="category_name"/>
        <result property="title"         column="title"/>
        <result property="pics"          column="pics"/>
        <result property="status"        column="status"/>
        <result property="versionNo"     column="version_no"/>
        <result property="viewCount"     column="view_count"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
        <result property="remark"        column="remark"/>
    </resultMap>

    <resultMap type="PolicyArticleVersion" id="PolicyArticleVersionResult">
        <result property="id"          column="id"/>
        <result property="articleId"   column="article_id"/>
        <result property="versionNo"   column="version_no"/>
        <result property="title"       column="title"/>
        <result property="pics"        column="pics"/>
        <result property="createBy"    column="create_by"/>
        <result property="createTime"  column="create_time"/>
    </resultMap>

    <sql id="selectPolicyArticleVo">
        select a.id, a.category_id, c.category_name, a.title, a.pics, a.status, a.version_no, a.view_count,
               a.create_by, a.create_time, a.update_by, a.update_time, a.remark
        from policy_article a
        left join policy_category c on c.id = a.category_id
    </sql>

    <sql id="selectPolicyArticleVersionVo">
        select id, article_id, version_no, title, pics, create_by, create_time
        from policy_article_version
    </sql>

    <select id="selectPolicyArticleList" parameterType="PolicyArticle" resultMap="PolicyArticleResult">
        <include refid="selectPolicyArticleVo"/>
        <where>
            <if test="categoryId != null"> and a.category_id = #{categoryId}</if>
            <if test="title != null and title != ''"> and a.title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''"> and a.status = #{status}</if>
        </where>
        order by a.create_time desc
    </select>

    <select id="selectPolicyArticleById" parameterType="Long" resultMap="PolicyArticleResult">
        <include refid="selectPolicyArticleVo"/>
        where a.id = #{id}
    </select>

    <select id="selectCurrentByCategoryId" parameterType="Long" resultMap="PolicyArticleResult">
        <include refid="selectPolicyArticleVo"/>
        where a.category_id = #{categoryId} and a.status = '1'
        order by a.version_no desc limit 1
    </select>

    <update id="incrementViewCount" parameterType="Long">
        update policy_article set view_count = view_count + 1 where id = #{id}
    </update>

    <insert id="insertPolicyArticle" parameterType="PolicyArticle" useGeneratedKeys="true" keyProperty="id">
        insert into policy_article
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">category_id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="pics != null">pics,</if>
            <if test="status != null">status,</if>
            <if test="versionNo != null">version_no,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">#{categoryId},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="pics != null">#{pics},</if>
            <if test="status != null">#{status},</if>
            <if test="versionNo != null">#{versionNo},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updatePolicyArticle" parameterType="PolicyArticle">
        update policy_article
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="pics != null">pics = #{pics},</if>
            <if test="status != null">status = #{status},</if>
            <if test="versionNo != null">version_no = #{versionNo},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePolicyArticleById" parameterType="Long">
        delete from policy_article where id = #{id}
    </delete>

    <delete id="deletePolicyArticleByIds" parameterType="Long[]">
        delete from policy_article where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectVersionListByArticleId" parameterType="Long" resultMap="PolicyArticleVersionResult">
        <include refid="selectPolicyArticleVersionVo"/>
        where article_id = #{articleId}
        order by version_no desc
    </select>

    <select id="selectVersionById" parameterType="Long" resultMap="PolicyArticleVersionResult">
        <include refid="selectPolicyArticleVersionVo"/>
        where id = #{id}
    </select>

    <insert id="insertPolicyArticleVersion" parameterType="PolicyArticleVersion">
        insert into policy_article_version(article_id, version_no, title, pics, create_by, create_time)
        values (#{articleId}, #{versionNo}, #{title}, #{pics}, #{createBy}, #{createTime})
    </insert>

    <select id="selectMaxVersionNoByArticleId" parameterType="Long" resultType="Integer">
        select max(version_no) from policy_article_version
        <where>
            <if test="articleId != null">article_id = #{articleId}</if>
        </where>
    </select>
</mapper>
