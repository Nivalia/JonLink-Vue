<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.JonlinkCompanyContactMapper">
    
    <resultMap type="JonlinkCompanyContact" id="JonlinkCompanyContactResult">
        <result property="id"    column="id"    />
        <result property="companyId"    column="company_id"    />
        <result property="contactId"    column="contact_id"    />
        <result property="isPrimary"    column="is_primary"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
    </resultMap>

    <sql id="selectJonlinkCompanyContactVo">
        select id, company_id, contact_id, is_primary, status, create_time, create_by from jonlink_company_contact
    </sql>

    <select id="selectJonlinkCompanyContactList" parameterType="JonlinkCompanyContact" resultMap="JonlinkCompanyContactResult">
        <include refid="selectJonlinkCompanyContactVo"/>
        <where>  
            <if test="companyId != null "> and company_id = #{companyId}</if>
            <if test="contactId != null "> and contact_id = #{contactId}</if>
        </where>
    </select>
    
    <select id="selectJonlinkCompanyContactById" parameterType="Long" resultMap="JonlinkCompanyContactResult">
        <include refid="selectJonlinkCompanyContactVo"/>
        where id = #{id}
    </select>

    <insert id="insertJonlinkCompanyContact" parameterType="JonlinkCompanyContact" useGeneratedKeys="true" keyProperty="id">
        insert into jonlink_company_contact
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="companyId != null">company_id,</if>
            <if test="contactId != null">contact_id,</if>
            <if test="isPrimary != null and isPrimary != ''">is_primary,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="companyId != null">#{companyId},</if>
            <if test="contactId != null">#{contactId},</if>
            <if test="isPrimary != null and isPrimary != ''">#{isPrimary},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
         </trim>
    </insert>

    <update id="updateJonlinkCompanyContact" parameterType="JonlinkCompanyContact">
        update jonlink_company_contact
        <trim prefix="SET" suffixOverrides=",">
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="contactId != null">contact_id = #{contactId},</if>
            <if test="isPrimary != null and isPrimary != ''">is_primary = #{isPrimary},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJonlinkCompanyContactById" parameterType="Long">
        delete from jonlink_company_contact where id = #{id}
    </delete>

    <delete id="deleteJonlinkCompanyContactByIds" parameterType="String">
        delete from jonlink_company_contact where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>