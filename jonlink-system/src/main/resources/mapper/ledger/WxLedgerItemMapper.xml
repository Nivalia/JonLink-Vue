<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.WxLedgerItemMapper">
    
    <resultMap type="WxLedgerItem" id="WxLedgerItemResult">
        <result property="id"    column="id"    />
        <result property="ledgerNo"    column="ledger_no"    />
        <result property="ledgerType"    column="ledger_type"    />
        <result property="bizNo"    column="biz_no"    />
        <result property="phone"    column="phone"    />
        <result property="openid"    column="openid"    />
        <result property="amount"    column="amount"    />
        <result property="points"    column="points"    />
        <result property="direction"    column="direction"    />
        <result property="bizUser"    column="biz_user"    />
        <result property="status"    column="status"    />
        <result property="occurredTime"    column="occurred_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWxLedgerItemVo">
        select id, ledger_no, ledger_type, biz_no, phone, openid, amount, points, direction, biz_user, status, occurred_time, create_by, create_time, update_by, update_time, remark from wx_ledger_item
    </sql>

    <select id="selectWxLedgerItemList" parameterType="WxLedgerItem" resultMap="WxLedgerItemResult">
        <include refid="selectWxLedgerItemVo"/>
        <where>  
            <if test="ledgerType != null  and ledgerType != ''"> and ledger_type = #{ledgerType}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
        </where>
    </select>
    
    <select id="selectWxLedgerItemById" parameterType="Long" resultMap="WxLedgerItemResult">
        <include refid="selectWxLedgerItemVo"/>
        where id = #{id}
    </select>

    <insert id="insertWxLedgerItem" parameterType="WxLedgerItem" useGeneratedKeys="true" keyProperty="id">
        insert into wx_ledger_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ledgerNo != null and ledgerNo != ''">ledger_no,</if>
            <if test="ledgerType != null and ledgerType != ''">ledger_type,</if>
            <if test="bizNo != null and bizNo != ''">biz_no,</if>
            <if test="phone != null">phone,</if>
            <if test="openid != null">openid,</if>
            <if test="amount != null">amount,</if>
            <if test="points != null">points,</if>
            <if test="direction != null and direction != ''">direction,</if>
            <if test="bizUser != null">biz_user,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="occurredTime != null">occurred_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ledgerNo != null and ledgerNo != ''">#{ledgerNo},</if>
            <if test="ledgerType != null and ledgerType != ''">#{ledgerType},</if>
            <if test="bizNo != null and bizNo != ''">#{bizNo},</if>
            <if test="phone != null">#{phone},</if>
            <if test="openid != null">#{openid},</if>
            <if test="amount != null">#{amount},</if>
            <if test="points != null">#{points},</if>
            <if test="direction != null and direction != ''">#{direction},</if>
            <if test="bizUser != null">#{bizUser},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="occurredTime != null">#{occurredTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateWxLedgerItem" parameterType="WxLedgerItem">
        update wx_ledger_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="ledgerNo != null and ledgerNo != ''">ledger_no = #{ledgerNo},</if>
            <if test="ledgerType != null and ledgerType != ''">ledger_type = #{ledgerType},</if>
            <if test="bizNo != null and bizNo != ''">biz_no = #{bizNo},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="openid != null">openid = #{openid},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="points != null">points = #{points},</if>
            <if test="direction != null and direction != ''">direction = #{direction},</if>
            <if test="bizUser != null">biz_user = #{bizUser},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="occurredTime != null">occurred_time = #{occurredTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWxLedgerItemById" parameterType="Long">
        delete from wx_ledger_item where id = #{id}
    </delete>

    <delete id="deleteWxLedgerItemByIds" parameterType="String">
        delete from wx_ledger_item where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>