<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.JonlinkContactPersonMapper">
    
    <resultMap type="JonlinkContactPerson" id="JonlinkContactPersonResult">
        <result property="id"    column="id"    />
        <result property="contactName"    column="contact_name"    />
        <result property="phone"    column="phone"    />
        <result property="wechat"    column="wechat"    />
        <result property="email"    column="email"    />
        <result property="title"    column="title"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectJonlinkContactPersonVo">
        select id, contact_name, phone, wechat, email, title, status, remark, create_by, create_time, update_by, update_time from jonlink_contact_person
    </sql>

    <select id="selectJonlinkContactPersonList" parameterType="JonlinkContactPerson" resultMap="JonlinkContactPersonResult">
        <include refid="selectJonlinkContactPersonVo"/>
        <where>  
            <if test="contactName != null  and contactName != ''"> and contact_name like concat('%', #{contactName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectJonlinkContactPersonById" parameterType="Long" resultMap="JonlinkContactPersonResult">
        <include refid="selectJonlinkContactPersonVo"/>
        where id = #{id}
    </select>

    <insert id="insertJonlinkContactPerson" parameterType="JonlinkContactPerson" useGeneratedKeys="true" keyProperty="id">
        insert into jonlink_contact_person
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="contactName != null and contactName != ''">contact_name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="wechat != null">wechat,</if>
            <if test="email != null">email,</if>
            <if test="title != null">title,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="contactName != null and contactName != ''">#{contactName},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="wechat != null">#{wechat},</if>
            <if test="email != null">#{email},</if>
            <if test="title != null">#{title},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateJonlinkContactPerson" parameterType="JonlinkContactPerson">
        update jonlink_contact_person
        <trim prefix="SET" suffixOverrides=",">
            <if test="contactName != null and contactName != ''">contact_name = #{contactName},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="wechat != null">wechat = #{wechat},</if>
            <if test="email != null">email = #{email},</if>
            <if test="title != null">title = #{title},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteJonlinkContactPersonById" parameterType="Long">
        delete from jonlink_contact_person where id = #{id}
    </delete>

    <delete id="deleteJonlinkContactPersonByIds" parameterType="String">
        delete from jonlink_contact_person where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>