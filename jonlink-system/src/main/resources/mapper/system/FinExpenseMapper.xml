<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.FinExpenseMapper">
    
    <resultMap type="FinExpense" id="FinExpenseResult">
        <result property="id"    column="id"    />
        <result property="expenseNo"    column="expense_no"    />
        <result property="applicant"    column="applicant"    />
        <result property="deptName"    column="dept_name"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="expenseType"    column="expense_type"    />
        <result property="status"    column="status"    />
        <result property="approver"    column="approver"    />
        <result property="approveTime"    column="approve_time"    />
        <result property="rejectReason"    column="reject_reason"    />
        <result property="paymentId"    column="payment_id"    />
        <result property="voucherId"    column="voucher_id"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    
        <result property="voucherNo"    column="voucher_no"    />
        <result property="itemCount"    column="item_count"    />
    </resultMap>

    <sql id="selectFinExpenseVo">
        select e.*
        , v.voucher_no AS voucher_no
        , (SELECT COUNT(1) FROM fin_expense_item ei WHERE ei.expense_id = e.id) AS item_count
        from fin_expense e
        LEFT JOIN fin_voucher v ON e.voucher_id = v.id
    </sql>

    <select id="selectFinExpenseList" parameterType="FinExpense" resultMap="FinExpenseResult">
        <include refid="selectFinExpenseVo"/>
        <where>  
            <if test="expenseNo != null  and expenseNo != ''"> and e.expense_no = #{expenseNo}</if>
            <if test="applicant != null  and applicant != ''"> and e.applicant = #{applicant}</if>
            <if test="deptName != null  and deptName != ''"> and dept_name like concat('%', #{deptName}, '%')</if>
            <if test="totalAmount != null "> and e.total_amount = #{totalAmount}</if>
            <if test="expenseType != null  and expenseType != ''"> and e.expense_type = #{expenseType}</if>
            <if test="status != null  and status != ''"> and e.status = #{status}</if>
            <if test="approver != null  and approver != ''"> and approver = #{approver}</if>
            <if test="approveTime != null "> and approve_time = #{approveTime}</if>
            <if test="rejectReason != null  and rejectReason != ''"> and reject_reason = #{rejectReason}</if>
            <if test="paymentId != null "> and payment_id = #{paymentId}</if>
            <if test="voucherId != null "> and e.voucher_id = #{voucherId}</if>
        </where>
    </select>
    
    <select id="selectFinExpenseById" parameterType="Long" resultMap="FinExpenseResult">
        <include refid="selectFinExpenseVo"/>
        where id = #{id}
    </select>

    <insert id="insertFinExpense" parameterType="FinExpense" useGeneratedKeys="true" keyProperty="id">
        insert into fin_expense
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="expenseNo != null and expenseNo != ''">expense_no,</if>
            <if test="applicant != null">applicant,</if>
            <if test="deptName != null">dept_name,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="expenseType != null and expenseType != ''">expense_type,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="approver != null">approver,</if>
            <if test="approveTime != null">approve_time,</if>
            <if test="rejectReason != null">reject_reason,</if>
            <if test="paymentId != null">payment_id,</if>
            <if test="voucherId != null">voucher_id,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="expenseNo != null and expenseNo != ''">#{expenseNo},</if>
            <if test="applicant != null">#{applicant},</if>
            <if test="deptName != null">#{deptName},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="expenseType != null and expenseType != ''">#{expenseType},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="approver != null">#{approver},</if>
            <if test="approveTime != null">#{approveTime},</if>
            <if test="rejectReason != null">#{rejectReason},</if>
            <if test="paymentId != null">#{paymentId},</if>
            <if test="voucherId != null">#{voucherId},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateFinExpense" parameterType="FinExpense">
        update fin_expense
        <trim prefix="SET" suffixOverrides=",">
            <if test="expenseNo != null and expenseNo != ''">expense_no = #{expenseNo},</if>
            <if test="applicant != null">applicant = #{applicant},</if>
            <if test="deptName != null">dept_name = #{deptName},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="expenseType != null and expenseType != ''">expense_type = #{expenseType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="approver != null">approver = #{approver},</if>
            <if test="approveTime != null">approve_time = #{approveTime},</if>
            <if test="rejectReason != null">reject_reason = #{rejectReason},</if>
            <if test="paymentId != null">payment_id = #{paymentId},</if>
            <if test="voucherId != null">voucher_id = #{voucherId},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinExpenseById" parameterType="Long">
        delete from fin_expense where id = #{id}
    </delete>

    <delete id="deleteFinExpenseByIds" parameterType="String">
        delete from fin_expense where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>