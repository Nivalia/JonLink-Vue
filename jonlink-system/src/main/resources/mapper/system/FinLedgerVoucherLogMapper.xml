    <sql id="selectFinLedgerVoucherLogVo">        select l.*
        , sp.bill_no AS settle_record_no from fin_ledger_voucher_log l
        LEFT JOIN fin_payment sp ON l.book_type IN ('1','2','4') AND l.settle_record_id = sp.id
    </sql>

