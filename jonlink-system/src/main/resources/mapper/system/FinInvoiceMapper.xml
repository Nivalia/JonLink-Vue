<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.FinInvoiceMapper">
    
    <resultMap type="FinInvoice" id="FinInvoiceResult">
        <result property="id"    column="id"    />
        <result property="invoiceNo"    column="invoice_no"    />
        <result property="invoiceType"    column="invoice_type"    />
        <result property="partnerId"    column="partner_id"    />
        <result property="direction"    column="direction"    />
        <result property="amount"    column="amount"    />
        <result property="taxAmount"    column="tax_amount"    />
        <result property="invoiceDate"    column="invoice_date"    />
        <result property="relateType"    column="relate_type"    />
        <result property="relateId"    column="relate_id"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    
        <result property="partnerName"    column="partner_name"    />
    </resultMap>

    <sql id="selectFinInvoiceVo">        select i.*
        , p.partner_name AS partner_name from fin_invoice i
        LEFT JOIN fin_partner p ON i.partner_id = p.id
    </sql>

    <select id="selectFinInvoiceList" parameterType="FinInvoice" resultMap="FinInvoiceResult">
        <include refid="selectFinInvoiceVo"/>
        <where>  
            <if test="invoiceNo != null  and invoiceNo != ''"> and i.invoice_no = #{invoiceNo}</if>
            <if test="invoiceType != null  and invoiceType != ''"> and i.invoice_type = #{invoiceType}</if>
            <if test="partnerId != null "> and i.partner_id = #{partnerId}</if>
            <if test="direction != null  and direction != ''"> and i.direction = #{direction}</if>
            <if test="amount != null "> and i.amount = #{amount}</if>
            <if test="taxAmount != null "> and i.tax_amount = #{taxAmount}</if>
            <if test="invoiceDate != null "> and i.invoice_date = #{invoiceDate}</if>
            <if test="relateType != null  and relateType != ''"> and i.relate_type = #{relateType}</if>
            <if test="relateId != null "> and i.relate_id = #{relateId}</if>
            <if test="status != null  and status != ''"> and i.status = #{status}</if>
        </where>
    </select>
    
    <select id="selectFinInvoiceById" parameterType="Long" resultMap="FinInvoiceResult">
        <include refid="selectFinInvoiceVo"/>
        where id = #{id}
    </select>

    <insert id="insertFinInvoice" parameterType="FinInvoice" useGeneratedKeys="true" keyProperty="id">
        insert into fin_invoice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="invoiceNo != null and invoiceNo != ''">invoice_no,</if>
            <if test="invoiceType != null and invoiceType != ''">invoice_type,</if>
            <if test="partnerId != null">partner_id,</if>
            <if test="direction != null and direction != ''">direction,</if>
            <if test="amount != null">amount,</if>
            <if test="taxAmount != null">tax_amount,</if>
            <if test="invoiceDate != null">invoice_date,</if>
            <if test="relateType != null">relate_type,</if>
            <if test="relateId != null">relate_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="invoiceNo != null and invoiceNo != ''">#{invoiceNo},</if>
            <if test="invoiceType != null and invoiceType != ''">#{invoiceType},</if>
            <if test="partnerId != null">#{partnerId},</if>
            <if test="direction != null and direction != ''">#{direction},</if>
            <if test="amount != null">#{amount},</if>
            <if test="taxAmount != null">#{taxAmount},</if>
            <if test="invoiceDate != null">#{invoiceDate},</if>
            <if test="relateType != null">#{relateType},</if>
            <if test="relateId != null">#{relateId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateFinInvoice" parameterType="FinInvoice">
        update fin_invoice
        <trim prefix="SET" suffixOverrides=",">
            <if test="invoiceNo != null and invoiceNo != ''">invoice_no = #{invoiceNo},</if>
            <if test="invoiceType != null and invoiceType != ''">invoice_type = #{invoiceType},</if>
            <if test="partnerId != null">partner_id = #{partnerId},</if>
            <if test="direction != null and direction != ''">direction = #{direction},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="taxAmount != null">tax_amount = #{taxAmount},</if>
            <if test="invoiceDate != null">invoice_date = #{invoiceDate},</if>
            <if test="relateType != null">relate_type = #{relateType},</if>
            <if test="relateId != null">relate_id = #{relateId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinInvoiceById" parameterType="Long">
        delete from fin_invoice where id = #{id}
    </delete>

    <delete id="deleteFinInvoiceByIds" parameterType="String">
        delete from fin_invoice where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>