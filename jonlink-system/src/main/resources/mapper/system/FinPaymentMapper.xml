<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.FinPaymentMapper">
    
    <resultMap type="FinPayment" id="FinPaymentResult">
        <result property="id"    column="id"    />
        <result property="billNo"    column="bill_no"    />
        <result property="partnerId"    column="partner_id"    />
        <result property="bankAccountId"    column="bank_account_id"    />
        <result property="amount"    column="amount"    />
        <result property="bizType"    column="biz_type"    />
        <result property="sourceType"    column="source_type"    />
        <result property="sourceId"    column="source_id"    />
        <result property="billDate"    column="bill_date"    />
        <result property="status"    column="status"    />
        <result property="voucherId"    column="voucher_id"    />
        <result property="confirmTime"    column="confirm_time"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    
        <result property="partnerName"    column="partner_name"    />
        <result property="bankAccountName"    column="bank_account_name"    />
        <result property="voucherNo"    column="voucher_no"    />
    </resultMap>

    <sql id="selectFinPaymentVo">        select t.*
        , p.partner_name AS partner_name
        , ba.account_name AS bank_account_name
        , v.voucher_no AS voucher_no from fin_payment t
        LEFT JOIN fin_partner p ON t.partner_id = p.id
        LEFT JOIN fin_bank_account ba ON t.bank_account_id = ba.id
        LEFT JOIN fin_voucher v ON t.voucher_id = v.id
    </sql>

    <select id="selectFinPaymentList" parameterType="FinPayment" resultMap="FinPaymentResult">
        <include refid="selectFinPaymentVo"/>
        <where>  
            <if test="billNo != null  and billNo != ''"> and bill_no = #{billNo}</if>
            <if test="partnerId != null "> and partner_id = #{partnerId}</if>
            <if test="bankAccountId != null "> and bank_account_id = #{bankAccountId}</if>
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="bizType != null  and bizType != ''"> and biz_type = #{bizType}</if>
            <if test="sourceType != null  and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="sourceId != null "> and source_id = #{sourceId}</if>
            <if test="billDate != null "> and bill_date = #{billDate}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="voucherId != null "> and voucher_id = #{voucherId}</if>
            <if test="confirmTime != null "> and confirm_time = #{confirmTime}</if>
        </where>
    </select>
    
    <select id="selectFinPaymentById" parameterType="Long" resultMap="FinPaymentResult">
        <include refid="selectFinPaymentVo"/>
        where id = #{id}
    </select>

    <insert id="insertFinPayment" parameterType="FinPayment" useGeneratedKeys="true" keyProperty="id">
        insert into fin_payment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="billNo != null and billNo != ''">bill_no,</if>
            <if test="partnerId != null">partner_id,</if>
            <if test="bankAccountId != null">bank_account_id,</if>
            <if test="amount != null">amount,</if>
            <if test="bizType != null">biz_type,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="billDate != null">bill_date,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="voucherId != null">voucher_id,</if>
            <if test="confirmTime != null">confirm_time,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="billNo != null and billNo != ''">#{billNo},</if>
            <if test="partnerId != null">#{partnerId},</if>
            <if test="bankAccountId != null">#{bankAccountId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="bizType != null">#{bizType},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="billDate != null">#{billDate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="voucherId != null">#{voucherId},</if>
            <if test="confirmTime != null">#{confirmTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateFinPayment" parameterType="FinPayment">
        update fin_payment
        <trim prefix="SET" suffixOverrides=",">
            <if test="billNo != null and billNo != ''">bill_no = #{billNo},</if>
            <if test="partnerId != null">partner_id = #{partnerId},</if>
            <if test="bankAccountId != null">bank_account_id = #{bankAccountId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="bizType != null">biz_type = #{bizType},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="billDate != null">bill_date = #{billDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="voucherId != null">voucher_id = #{voucherId},</if>
            <if test="confirmTime != null">confirm_time = #{confirmTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinPaymentById" parameterType="Long">
        delete from fin_payment where id = #{id}
    </delete>

    <delete id="deleteFinPaymentByIds" parameterType="String">
        delete from fin_payment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>