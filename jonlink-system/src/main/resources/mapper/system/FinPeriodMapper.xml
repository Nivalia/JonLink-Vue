<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.FinPeriodMapper">
    
    <resultMap type="FinPeriod" id="FinPeriodResult">
        <result property="id"    column="id"    />
        <result property="periodCode"    column="period_code"    />
        <result property="periodName"    column="period_name"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="status"    column="status"    />
        <result property="closeUser"    column="close_user"    />
        <result property="closeTime"    column="close_time"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectFinPeriodVo">
        select id, period_code, period_name, start_date, end_date, status, close_user, close_time, remark, create_by, create_time, update_by, update_time from fin_period
    </sql>

    <select id="selectFinPeriodList" parameterType="FinPeriod" resultMap="FinPeriodResult">
        <include refid="selectFinPeriodVo"/>
        <where>  
            <if test="periodCode != null  and periodCode != ''"> and period_code = #{periodCode}</if>
            <if test="periodName != null  and periodName != ''"> and period_name like concat('%', #{periodName}, '%')</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="endDate != null "> and end_date = #{endDate}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="closeUser != null  and closeUser != ''"> and close_user = #{closeUser}</if>
            <if test="closeTime != null "> and close_time = #{closeTime}</if>
        </where>
    </select>
    
    <select id="selectFinPeriodById" parameterType="Long" resultMap="FinPeriodResult">
        <include refid="selectFinPeriodVo"/>
        where id = #{id}
    </select>

    <insert id="insertFinPeriod" parameterType="FinPeriod" useGeneratedKeys="true" keyProperty="id">
        insert into fin_period
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="periodCode != null and periodCode != ''">period_code,</if>
            <if test="periodName != null and periodName != ''">period_name,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="closeUser != null">close_user,</if>
            <if test="closeTime != null">close_time,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="periodCode != null and periodCode != ''">#{periodCode},</if>
            <if test="periodName != null and periodName != ''">#{periodName},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="closeUser != null">#{closeUser},</if>
            <if test="closeTime != null">#{closeTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateFinPeriod" parameterType="FinPeriod">
        update fin_period
        <trim prefix="SET" suffixOverrides=",">
            <if test="periodCode != null and periodCode != ''">period_code = #{periodCode},</if>
            <if test="periodName != null and periodName != ''">period_name = #{periodName},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="closeUser != null">close_user = #{closeUser},</if>
            <if test="closeTime != null">close_time = #{closeTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinPeriodById" parameterType="Long">
        delete from fin_period where id = #{id}
    </delete>

    <delete id="deleteFinPeriodByIds" parameterType="String">
        delete from fin_period where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 按 period_code 查 -->
    <select id="selectFinPeriodByCode" parameterType="String" resultMap="FinPeriodResult">
        <include refid="selectFinPeriodVo"/>
        where period_code = #{periodCode}
        limit 1
    </select>
</mapper>