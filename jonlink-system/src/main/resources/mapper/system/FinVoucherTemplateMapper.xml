<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.FinVoucherTemplateMapper">
    
    <resultMap type="FinVoucherTemplate" id="FinVoucherTemplateResult">
        <result property="id"    column="id"    />
        <result property="templateCode"    column="template_code"    />
        <result property="templateName"    column="template_name"    />
        <result property="voucherSummary"    column="voucher_summary"    />
        <result property="entriesJson"    column="entries_json"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectFinVoucherTemplateVo">
        select id, template_code, template_name, voucher_summary, entries_json, remark, status, create_by, create_time, update_by, update_time from fin_voucher_template
    </sql>

    <select id="selectFinVoucherTemplateList" parameterType="FinVoucherTemplate" resultMap="FinVoucherTemplateResult">
        <include refid="selectFinVoucherTemplateVo"/>
        <where>  
            <if test="templateCode != null  and templateCode != ''"> and template_code = #{templateCode}</if>
            <if test="templateName != null  and templateName != ''"> and template_name like concat('%', #{templateName}, '%')</if>
            <if test="voucherSummary != null  and voucherSummary != ''"> and voucher_summary = #{voucherSummary}</if>
            <if test="entriesJson != null  and entriesJson != ''"> and entries_json = #{entriesJson}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectFinVoucherTemplateById" parameterType="Long" resultMap="FinVoucherTemplateResult">
        <include refid="selectFinVoucherTemplateVo"/>
        where id = #{id}
    </select>

    <select id="selectFinVoucherTemplateByCode" parameterType="String" resultMap="FinVoucherTemplateResult">
        <include refid="selectFinVoucherTemplateVo"/>
        where template_code = #{templateCode} and status = '1'
    </select>

    <insert id="insertFinVoucherTemplate" parameterType="FinVoucherTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into fin_voucher_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateCode != null and templateCode != ''">template_code,</if>
            <if test="templateName != null and templateName != ''">template_name,</if>
            <if test="voucherSummary != null">voucher_summary,</if>
            <if test="entriesJson != null and entriesJson != ''">entries_json,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="templateCode != null and templateCode != ''">#{templateCode},</if>
            <if test="templateName != null and templateName != ''">#{templateName},</if>
            <if test="voucherSummary != null">#{voucherSummary},</if>
            <if test="entriesJson != null and entriesJson != ''">#{entriesJson},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateFinVoucherTemplate" parameterType="FinVoucherTemplate">
        update fin_voucher_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="templateCode != null and templateCode != ''">template_code = #{templateCode},</if>
            <if test="templateName != null and templateName != ''">template_name = #{templateName},</if>
            <if test="voucherSummary != null">voucher_summary = #{voucherSummary},</if>
            <if test="entriesJson != null and entriesJson != ''">entries_json = #{entriesJson},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinVoucherTemplateById" parameterType="Long">
        delete from fin_voucher_template where id = #{id}
    </delete>

    <delete id="deleteFinVoucherTemplateByIds" parameterType="String">
        delete from fin_voucher_template where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>