<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jonlink.system.mapper.FinPartnerMapper">
    
    <resultMap type="FinPartner" id="FinPartnerResult">
        <result property="id"    column="id"    />
        <result property="partnerType"    column="partner_type"    />
        <result property="partnerName"    column="partner_name"    />
        <result property="refTable"    column="ref_table"    />
        <result property="refId"    column="ref_id"    />
        <result property="phone"    column="phone"    />
        <result property="contact"    column="contact"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectFinPartnerVo">
        select id, partner_type, partner_name, ref_table, ref_id, phone, contact, status, remark, create_by, create_time, update_by, update_time from fin_partner
    </sql>

    <select id="selectFinPartnerList" parameterType="FinPartner" resultMap="FinPartnerResult">
        <include refid="selectFinPartnerVo"/>
        <where>  
            <if test="partnerType != null  and partnerType != ''"> and partner_type = #{partnerType}</if>
            <if test="partnerName != null  and partnerName != ''"> and partner_name like concat('%', #{partnerName}, '%')</if>
            <if test="refTable != null  and refTable != ''"> and ref_table = #{refTable}</if>
            <if test="refId != null "> and ref_id = #{refId}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="contact != null  and contact != ''"> and contact = #{contact}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectFinPartnerById" parameterType="Long" resultMap="FinPartnerResult">
        <include refid="selectFinPartnerVo"/>
        where id = #{id}
    </select>

    <insert id="insertFinPartner" parameterType="FinPartner" useGeneratedKeys="true" keyProperty="id">
        insert into fin_partner
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="partnerType != null and partnerType != ''">partner_type,</if>
            <if test="partnerName != null and partnerName != ''">partner_name,</if>
            <if test="refTable != null">ref_table,</if>
            <if test="refId != null">ref_id,</if>
            <if test="phone != null">phone,</if>
            <if test="contact != null">contact,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="partnerType != null and partnerType != ''">#{partnerType},</if>
            <if test="partnerName != null and partnerName != ''">#{partnerName},</if>
            <if test="refTable != null">#{refTable},</if>
            <if test="refId != null">#{refId},</if>
            <if test="phone != null">#{phone},</if>
            <if test="contact != null">#{contact},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateFinPartner" parameterType="FinPartner">
        update fin_partner
        <trim prefix="SET" suffixOverrides=",">
            <if test="partnerType != null and partnerType != ''">partner_type = #{partnerType},</if>
            <if test="partnerName != null and partnerName != ''">partner_name = #{partnerName},</if>
            <if test="refTable != null">ref_table = #{refTable},</if>
            <if test="refId != null">ref_id = #{refId},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFinPartnerById" parameterType="Long">
        delete from fin_partner where id = #{id}
    </delete>

    <delete id="deleteFinPartnerByIds" parameterType="String">
        delete from fin_partner where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>